# Patch from a demo video of the hardware: +ENV OUT -> OSC 2 PITCH IN, SYNC on, VCA KB RLS, SUSTAIN low.
# Hardware excerpt: 19.0 ... 30.6 s of the video soundtrack (not in the repository: pass the WAV to compare.py).
# Part transcribed from the bass pitch of the recording (hardware ~18 cents sharp), played detached: each new key
# restarts the envelope attack from its current level, as the recording shows. Times in seconds from the excerpt start.
# Envelope knobs fitted to the sweep of the recording with a model of the plugin envelope (method in README.md):
# attack tau ~0.8 s, release tau ~0.24 s. CUTOFF wide open (11 kHz) matches the brightness of the recording (README).
set osc1Octave 1   # 16'
set osc1Wave 1
set osc2Octave 2   # 4': oscillator 2 two octaves above 1, as the start of every sweep
set osc2Wave 1
set osc2Sync 1
set mixOsc1 0.5
set mixOsc2 0.5
set cutoff 0.9135   # 11 kHz
set vcaMode 1      # KB RLS
set attack 0.84
set decay 0.30
set sustain 0.0
set release 0.70
set fineTune 0.18
set drift 0.25
set volume 0.8
patch envPosOut:osc2PitchIn
length 11.6
on 0.360 53
off 1.540 53
on 1.570 56
off 1.750 56
on 2.300 58
off 2.490 58
on 2.520 60
off 2.740 60
on 2.770 58
off 3.590 58
on 3.620 56
off 3.740 56
on 3.770 58
off 3.890 58
on 3.920 56
off 4.060 56
on 4.240 54
off 5.090 54
on 5.120 56
off 5.290 56
on 5.320 54
off 5.490 54
on 5.520 53
off 5.760 53
on 5.790 51
off 5.990 51
on 6.020 53
off 6.220 53
on 6.250 51
off 6.440 51
on 6.470 49
off 6.980 49
on 7.480 48
off 7.940 48
on 7.970 51
off 8.240 51
on 8.270 53
off 8.840 53
on 8.870 51
off 8.940 51
on 8.970 49
off 9.090 49
on 9.120 48
off 9.900 48
